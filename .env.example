# Frontend: copy to frontend/.env locally, or set in Vercel frontend settings.
# Use only the API origin, e.g. https://YOUR-API.vercel.app (without /api).
# Empty uses the Vite proxy in local development. Rebuild after changes.
VITE_API_BASE_URL=
# Backend: set in the backend process or Vercel API project, NOT frontend/.env.
# Comma-separated exact frontend origins, with no path or trailing slash.
# Vercel example: https://YOUR-FRONTEND.vercel.app
# Add the exact frontend preview origin when testing a preview deployment.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend only. Never prefix credentials with VITE_ or commit a populated .env.
AZURE_OPENAI_RESPONSES_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT=football-insights
AZURE_OPENAI_API_KEY=
