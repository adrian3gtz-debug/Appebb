# Copy to backend/.env; this populated local file is ignored by Git.
# Backend only. Never place the key in frontend/.env or a VITE_ variable.
AZURE_OPENAI_RESPONSES_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT=football-insights
AZURE_OPENAI_API_KEY=

# Backend AI provider: azure_openai (default for compatibility) or groq.
# To switch to Groq, set AI_PROVIDER=groq and configure a private Groq key.
AI_PROVIDER=azure_openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
